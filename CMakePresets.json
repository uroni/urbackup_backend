{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "server",
      "displayName": "Server (vcpkg)",
      "inherits": "vcpkg"
    },
    {
      "name": "client",
      "displayName": "Client with GUI (vcpkg)",
      "inherits": "vcpkg",
      "cacheVariables": {
        "URBACKUP_BUILD_SERVER": "OFF",
        "URBACKUP_BUILD_CLIENT": "ON"
      }
    },
    {
      "name": "client-headless",
      "displayName": "Client without GUI (vcpkg)",
      "inherits": "client",
      "cacheVariables": {
        "URBACKUP_CLIENT_HEADLESS": "ON"
      }
    },
    {
      "name": "server-system",
      "displayName": "Server (system libraries)",
      "inherits": "vcpkg",
      "cacheVariables": {
        "URBACKUP_USE_SYSTEM_LIBS": "ON"
      }
    },
    {
      "name": "client-system",
      "displayName": "Client with GUI (system libraries)",
      "inherits": "vcpkg",
      "cacheVariables": {
        "URBACKUP_USE_SYSTEM_LIBS": "ON",
        "URBACKUP_BUILD_SERVER": "OFF",
        "URBACKUP_BUILD_CLIENT": "ON"
      }
    },
    {
      "name": "client-android",
      "hidden": true,
      "inherits": "client-headless",
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_PLATFORM": "android-30"
      }
    },
    {
      "name": "client-android-arm64",
      "displayName": "Client backend for Android, arm64 (vcpkg, NDK)",
      "inherits": "client-android",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    {
      "name": "client-android-x64",
      "displayName": "Client backend for Android, x86_64 (vcpkg, NDK)",
      "inherits": "client-android",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-android",
        "ANDROID_ABI": "x86_64"
      }
    },
    {
      "name": "client-headless-system",
      "displayName": "Client without GUI (system libraries)",
      "inherits": "client-system",
      "cacheVariables": {
        "URBACKUP_CLIENT_HEADLESS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "server", "configurePreset": "server" },
    { "name": "client", "configurePreset": "client" },
    { "name": "client-headless", "configurePreset": "client-headless" },
    { "name": "server-system", "configurePreset": "server-system" },
    { "name": "client-system", "configurePreset": "client-system" },
    { "name": "client-headless-system", "configurePreset": "client-headless-system" },
    { "name": "client-android-arm64", "configurePreset": "client-android-arm64" },
    { "name": "client-android-x64", "configurePreset": "client-android-x64" }
  ]
}
