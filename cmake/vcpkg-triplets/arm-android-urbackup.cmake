# Static client builds for Android (create_linux_installer.sh)
set(VCPKG_TARGET_ARCHITECTURE arm)
set(VCPKG_CRT_LINKAGE static)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_CMAKE_SYSTEM_NAME Android)
set(VCPKG_CMAKE_SYSTEM_VERSION 29)
set(VCPKG_MAKE_BUILD_TRIPLET "--host=armv7a-linux-androideabi")
set(VCPKG_CMAKE_CONFIGURE_OPTIONS -DANDROID_ABI=armeabi-v7a)
set(VCPKG_C_FLAGS "-march=armv7-a -mfpu=vfp -DCRYPTOPP_DISABLE_ASM")
set(VCPKG_CXX_FLAGS "-march=armv7-a -mfpu=vfp -DCRYPTOPP_DISABLE_ASM -DCRYPTOPP_INIT_PRIORITY=0")
