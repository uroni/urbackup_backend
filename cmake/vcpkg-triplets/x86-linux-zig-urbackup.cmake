# Static i686 (SSE2) musl client build with Zig (create_linux_installer.sh)
set(VCPKG_TARGET_ARCHITECTURE x86)
set(VCPKG_CRT_LINKAGE static)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_CMAKE_SYSTEM_NAME Linux)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE ${CMAKE_CURRENT_LIST_DIR}/../toolchains/zig.cmake)
set(VCPKG_CMAKE_CONFIGURE_OPTIONS -DZIG_TARGET=x86-linux-musl -DZIG_CPU=pentium4)
set(VCPKG_MAKE_BUILD_TRIPLET "--host=i686-linux-musl")
set(VCPKG_ENV_PASSTHROUGH ZIG ZIG_GLOBAL_CACHE_DIR ZIG_LOCAL_CACHE_DIR)
if(PORT STREQUAL "openssl")
	# OpenSSL calls __atomic_is_lock_free, which is in libatomic and not provided by zig on x86
	set(VCPKG_C_FLAGS "-DBROKEN_CLANG_ATOMICS")
	set(VCPKG_CXX_FLAGS "-DBROKEN_CLANG_ATOMICS")
endif()
