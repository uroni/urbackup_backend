# Static aarch64 musl client build with Zig (create_linux_installer.sh)
set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CRT_LINKAGE static)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_CMAKE_SYSTEM_NAME Linux)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE ${CMAKE_CURRENT_LIST_DIR}/../toolchains/zig.cmake)
set(VCPKG_CMAKE_CONFIGURE_OPTIONS -DZIG_TARGET=aarch64-linux-musl -DZIG_CPU=generic+crc)
set(VCPKG_MAKE_BUILD_TRIPLET "--host=aarch64-linux-musl")
set(VCPKG_ENV_PASSTHROUGH ZIG ZIG_GLOBAL_CACHE_DIR ZIG_LOCAL_CACHE_DIR)
