# Static armv7 (VFPv3-D16, no NEON) musl client build with Zig (create_linux_installer.sh)
set(VCPKG_TARGET_ARCHITECTURE arm)
set(VCPKG_CRT_LINKAGE static)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_CMAKE_SYSTEM_NAME Linux)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE ${CMAKE_CURRENT_LIST_DIR}/../toolchains/zig.cmake)
set(VCPKG_CMAKE_CONFIGURE_OPTIONS -DZIG_TARGET=arm-linux-musleabihf -DZIG_CPU=generic+v7a-neon-d32
	# No NEON. Crypto++'s ARM assembly needs NEON (and -march, which zig cc rejects)
	-DCRYPTOPP_DISABLE_ARM_NEON=ON)
set(VCPKG_MAKE_BUILD_TRIPLET "--host=arm-linux-musleabihf")
set(VCPKG_ENV_PASSTHROUGH ZIG ZIG_GLOBAL_CACHE_DIR ZIG_LOCAL_CACHE_DIR)
if(PORT STREQUAL "cryptopp")
	set(CRYPTOPP_DISABLE_ASM ON)
endif()
set(VCPKG_C_FLAGS "-DCRYPTOPP_DISABLE_ASM")
set(VCPKG_CXX_FLAGS "-DCRYPTOPP_DISABLE_ASM")
