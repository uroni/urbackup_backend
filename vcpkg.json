{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "urbackup",
  "version": "2.5.0",
  "dependencies": [
    {
      "name": "cryptopp",
      "default-features": true
    },
    {
      "name": "zstd",
      "default-features": true
    },
    {
      "name": "zlib",
      "default-features": true
    },
    {
      "name": "openssl",
      "platform": "!windows"
    }
  ],
  "features": {
    "server": {
      "description": "Server dependencies (mail/LDAP via libcurl)",
      "dependencies": [
        {
          "name": "curl",
          "default-features": false,
          "features": [
            "non-http",
            "ssl",
            "ldap"
          ]
        }
      ]
    },
    "gui": {
      "description": "Client GUI (urbackupclientgui)",
      "dependencies": [
        {
          "name": "wxwidgets",
          "default-features": false
        }
      ]
    },
    "c-ares": {
      "description": "Use c-ares for DNS resolution in the client",
      "dependencies": [
        "c-ares"
      ]
    }
  },
  "default-features": [
    "server"
  ]
}
